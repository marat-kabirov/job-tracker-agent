# Скопируй в .env и заполни реальными ключами. .env в .gitignore, не коммитить.

# Groq (бесплатный тариф) — https://console.groq.com/keys
GROQ_API_KEY=
# Опционально: переопределить модель по умолчанию (см. _llm.py и
# актуальный список на console.groq.com/docs/models)
# GROQ_MODEL=openai/gpt-oss-120b

# Путь к SQLite-базе трекера (по умолчанию data/tracker.db)
TRACKER_DB_PATH=data/tracker.db

# Путь к профилю резюме
RESUME_PROFILE_PATH=data/resume_profile.json
